{
  "name": "cram-server",
  "version": "1.0.0",
  "private": true,
  "description": "CRAM Express and MySQL authentication API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "setup:env": "node scripts/setup-env.js",
    "setup:db": "node scripts/init-database.js && npm run migrate",
    "migrate": "npm run migrate:dashboard && npm run migrate:workspace && npm run migrate:records",
    "format": "prettier --write ../CRM001 ../docs src scripts package.json ../README.md ../.prettierrc.json",
    "format:check": "prettier --check ../CRM001 ../docs src scripts package.json ../README.md ../.prettierrc.json",
    "migrate:dashboard": "node scripts/migrate-dashboard.js",
    "migrate:workspace": "node scripts/migrate-workspace.js",
    "test": "node scripts/check-validation.js && node scripts/check-api-client.js && node scripts/check-messenger-errors.js && node scripts/check-workspace.js",
    "test:fresh": "node scripts/check-fresh-install.js",
    "migrate:records": "node scripts/migrate-records.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
