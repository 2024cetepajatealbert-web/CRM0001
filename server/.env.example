PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:4173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=CRAMDB
DB_USER=root
DB_PASSWORD=replace_with_your_local_mysql_password
JWT_SECRET=replace_with_a_long_random_secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key private and backed up; changing it makes saved Page credentials unreadable.
CONNECTION_ENCRYPTION_KEY=replace_with_64_hex_characters
META_GRAPH_VERSION=v24.0
# Optional public HTTPS origin for webhook URLs. Leave blank for local Facebook sync.
PUBLIC_BASE_URL=
# Optional. Signup continues to work without email verification or SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
